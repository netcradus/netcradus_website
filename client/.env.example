# =================================================================
# NETCRADUS SERVER-SIDE ENVIRONMENT VARIABLES (.env)
# Do NOT commit actual secrets or credentials to source control.
# =================================================================

# --- SERVER-SIDE EMAIL SERVICE (Nodemailer / SMTP) ---
# Used by POST /api/contact to send notifications & visitor acknowledgements
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@netcradus.com
SMTP_PASS=your_app_password_here
NOTIFICATION_EMAIL=info@netcradus.com

# --- DATABASE PERSISTENCE (MongoDB Atlas or PostgreSQL) ---
# Required for persistent database storage of inquiries.
# If omitted, system safely defaults to local persistent store (.data/inquiries.json)
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/netcradus

# --- ADMIN DASHBOARD AUTHENTICATION TOKEN ---
# Protected key required to access GET/PATCH /api/admin-inquiries & /admin/inquiries UI
ADMIN_SECRET_TOKEN=netcradus_admin_secure_token_2026

# --- FRONTEND LOGGING & EMAILJS COMPATIBILITY ---
VITE_LOGGER_URL=https://netcradus-logger.onrender.com
